# ---------------------------------------------------------------------------
#  Copy this file to .env and fill it in. .env is gitignored; this file is not,
#  so never put a real credential in here.
#
#      cp .env.example .env
# ---------------------------------------------------------------------------

# REQUIRED. Your MongoDB connection string.
#
# Atlas: Database > Connect > Drivers, then copy the string and put your real
# password in place of <db_password>. The placeholder below is a dummy: the
# server refuses to start until you replace it, rather than failing later with a
# confusing DNS error.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Database name. Kept out of the URI so the same cluster can hold other things.
MONGODB_DB=gfd

# Where the server listens.
# Use 0.0.0.0 in production so Render can reach the process.
PORT=4500
HOST=0.0.0.0

# REQUIRED to read the data back. A long random string, yours only:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# While this is empty, GET /api/quiz-attempts is switched OFF completely. That is
# deliberate: her typed answers live behind this endpoint, and an unguarded read
# route would hand them to anyone who found the URL.
ADMIN_TOKEN=

# Browser origins allowed to POST attempts, comma separated.
# The server allows every browser origin by default, so this is optional.
# Set it only if you want to re-enable origin restrictions later.
#
#     ALLOWED_ORIGINS=https://your-site.example,http://localhost:5173
ALLOWED_ORIGINS=

# Optional. If set, visitor IPs are salted with this and stored as a short hash,
# so repeat attempts can be told apart without keeping anyone's address. Leave it
# empty and nothing IP-derived is stored at all.
IP_HASH_SALT=

# Optional. Delete attempts automatically after this many days. 0 keeps forever.
ATTEMPT_TTL_DAYS=0
